---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Pricing - Buuk"
  description="Simple, transparent pricing that scales with your business."
>
  <header style="padding: 2rem 1rem; border-bottom: 1px solid #e2e8f0;">
    <div style="max-width: 1200px; margin: 0 auto;">
      <img src="/buuklogo.png" alt="Buuk Logo" style="height: 50px;" />
    </div>
  </header>

  <main style="padding: 4rem 1rem;">
    <div style="max-width: 1200px; margin: 0 auto;">
      <h1 style="font-size: 2.5rem; margin-bottom: 1rem; text-align: center;">
        Simple, Transparent Pricing
      </h1>
      <p style="text-align: center; margin-bottom: 3rem; color: #64748b; font-size: 1.1rem;">
        Choose the plan that fits your business
      </p>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 2rem;">
        <div style="padding: 2rem; border: 2px solid #e2e8f0; border-radius: 8px; text-align: center;">
          <h3 style="font-size: 1.5rem; margin-bottom: 0.5rem;">Starter</h3>
          <p style="color: #64748b; margin-bottom: 1rem;">For small businesses</p>
          <p style="font-size: 2.5rem; font-weight: 700; margin-bottom: 2rem;"><span style="color: #667eea;">$29</span>/month</p>
          <ul style="text-align: left; margin-bottom: 2rem; list-style: none;">
            <li style="padding: 0.5rem 0;">✓ 1,000 appointments/month</li>
            <li style="padding: 0.5rem 0;">✓ 1 staff member</li>
            <li style="padding: 0.5rem 0;">✓ Basic reports</li>
          </ul>
          <button style="width: 100%; padding: 0.75rem; background: #667eea; color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: 600;">
            Get Started
          </button>
        </div>

        <div style="padding: 2rem; border: 3px solid #667eea; border-radius: 8px; text-align: center; position: relative; background: #f0f4ff;">
          <div style="position: absolute; top: -12px; left: 50%; transform: translateX(-50%); background: #667eea; color: white; padding: 0.25rem 1rem; border-radius: 20px; font-size: 0.875rem; font-weight: 600;">
            POPULAR
          </div>
          <h3 style="font-size: 1.5rem; margin-bottom: 0.5rem; margin-top: 0.5rem;">Professional</h3>
          <p style="color: #64748b; margin-bottom: 1rem;">For growing businesses</p>
          <p style="font-size: 2.5rem; font-weight: 700; margin-bottom: 2rem;"><span style="color: #667eea;">$79</span>/month</p>
          <ul style="text-align: left; margin-bottom: 2rem; list-style: none;">
            <li style="padding: 0.5rem 0;">✓ 10,000 appointments/month</li>
            <li style="padding: 0.5rem 0;">✓ 5 staff members</li>
            <li style="padding: 0.5rem 0;">✓ Advanced reports</li>
            <li style="padding: 0.5rem 0;">✓ Priority support</li>
          </ul>
          <button style="width: 100%; padding: 0.75rem; background: #667eea; color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: 600;">
            Get Started
          </button>
        </div>

        <div style="padding: 2rem; border: 2px solid #e2e8f0; border-radius: 8px; text-align: center;">
          <h3 style="font-size: 1.5rem; margin-bottom: 0.5rem;">Enterprise</h3>
          <p style="color: #64748b; margin-bottom: 1rem;">For large organizations</p>
          <p style="font-size: 2.5rem; font-weight: 700; margin-bottom: 2rem;"><span style="color: #667eea;">Custom</span></p>
          <ul style="text-align: left; margin-bottom: 2rem; list-style: none;">
            <li style="padding: 0.5rem 0;">✓ Unlimited appointments</li>
            <li style="padding: 0.5rem 0;">✓ Unlimited staff</li>
            <li style="padding: 0.5rem 0;">✓ Custom integrations</li>
            <li style="padding: 0.5rem 0;">✓ Dedicated support</li>
          </ul>
          <button style="width: 100%; padding: 0.75rem; background: #667eea; color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: 600;">
            Contact Us
          </button>
        </div>
      </div>
    </div>
  </main>

  <footer style="background: #0f172a; color: white; padding: 2rem 1rem; text-align: center; margin-top: 4rem;">
    <div style="max-width: 1200px; margin: 0 auto;">
      <p>&copy; 2024 Buuk. All rights reserved.</p>
    </div>
  </footer>
</BaseLayout>
