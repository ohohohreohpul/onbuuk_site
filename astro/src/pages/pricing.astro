---
import BaseLayout from '../layouts/BaseLayout.astro';

const plans = [
  {
    name: 'Free',
    price: '0',
    description: 'Perfect for getting started',
    features: ['1 admin user', 'Up to 50 bookings/month', 'Up to 3 services', 'Email notifications', 'Basic booking system'],
    highlighted: false
  },
  {
    name: 'Standard',
    price: '29',
    description: 'Ideal for small businesses',
    features: ['Up to 3 admin users', 'Unlimited bookings', 'Up to 10 services', 'Gift cards enabled', 'Basic loyalty program', 'Custom logo', 'Customer portal'],
    highlighted: true,
    badge: 'POPULAR'
  },
  {
    name: 'Pro',
    price: '45',
    description: 'Full power for growing businesses',
    features: ['Unlimited admin users', 'Unlimited bookings', 'Unlimited services', 'Advanced gift cards', 'Advanced loyalty program', 'Full custom branding', 'Priority support', 'Custom domain'],
    highlighted: false
  }
];

const faqs = [
  { q: 'Can I change plans later?', a: 'Yes! You can upgrade or downgrade your plan at any time. Changes take effect immediately.' },
  { q: 'Is there a free trial?', a: 'Yes, all plans include a 14-day free trial. No credit card required to start.' },
  { q: 'What payment methods do you accept?', a: 'We accept all major credit cards, PayPal, and bank transfers for annual plans.' },
];
---

<BaseLayout
  title="Pricing - Buuk Appointment Booking"
  description="Simple, transparent pricing that scales with your business. Start free and upgrade as you grow."
  currentPage="pricing"
>
  <main class="pt-16">
    <!-- Hero Section -->
    <section class="py-20 px-6 lg:px-24 bg-gradient-to-br from-gray-50 to-gray-100">
      <div class="max-w-7xl mx-auto text-center">
        <h1 class="text-4xl lg:text-5xl font-bold text-gray-900 mb-6">
          Simple, Transparent Pricing
        </h1>
        <p class="text-xl text-gray-600 max-w-2xl mx-auto">
          Choose the plan that fits your business. Start free and scale as you grow.
        </p>
      </div>
    </section>

    <!-- Pricing Cards -->
    <section class="py-20 px-6 lg:px-24">
      <div class="max-w-5xl mx-auto">
        <div class="grid md:grid-cols-3 gap-8">
          {plans.map((plan) => (
            <div class={`rounded-2xl p-8 text-center relative transition-all ${
              plan.highlighted 
                ? 'bg-primary text-white border-4 border-primary shadow-2xl scale-105' 
                : 'bg-white border-2 border-gray-200 hover:border-primary hover:shadow-xl'
            }`}>
              {plan.badge && (
                <div class="absolute -top-4 left-1/2 transform -translate-x-1/2 bg-secondary text-gray-900 px-4 py-1 rounded-full text-sm font-bold">
                  {plan.badge}
                </div>
              )}
              <h3 class={`text-2xl font-bold mb-2 ${plan.highlighted ? 'text-white' : 'text-gray-900'}`}>
                {plan.name}
              </h3>
              <p class={`text-sm mb-6 ${plan.highlighted ? 'text-white/80' : 'text-gray-600'}`}>
                {plan.description}
              </p>
              <p class="mb-8">
                <span class={`text-5xl font-bold ${plan.highlighted ? 'text-white' : 'text-primary'}`}>€{plan.price}</span>
                <span class={plan.highlighted ? 'text-white/80' : 'text-gray-600'}>/month</span>
              </p>
              <ul class="text-left space-y-3 mb-8">
                {plan.features.map((feature) => (
                  <li class="flex items-center gap-3">
                    <div class={`w-5 h-5 rounded flex items-center justify-center ${plan.highlighted ? 'bg-white/20' : 'bg-primary/10'}`}>
                      <svg class={`w-3 h-3 ${plan.highlighted ? 'text-white' : 'text-primary'}`} fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                      </svg>
                    </div>
                    <span class={`text-sm ${plan.highlighted ? 'text-white' : 'text-gray-700'}`}>{feature}</span>
                  </li>
                ))}
              </ul>
              <a 
                href="https://app.onbuuk.com"
                class={`block w-full py-3 rounded-lg font-semibold transition-all ${
                  plan.highlighted 
                    ? 'bg-white text-primary hover:bg-gray-100' 
                    : 'bg-primary text-white hover:bg-primary-dark'
                }`}
              >
                Get Started
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="py-20 px-6 lg:px-24 bg-gray-50">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl font-bold text-gray-900 text-center mb-12">
          Frequently Asked Questions
        </h2>
        <div class="space-y-6">
          {faqs.map((faq) => (
            <div class="bg-white border border-gray-200 rounded-xl p-6">
              <h3 class="font-semibold text-gray-900 mb-2">{faq.q}</h3>
              <p class="text-gray-600">{faq.a}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
