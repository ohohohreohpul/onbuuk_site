---
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const apiUrl = import.meta.env.API_URL || 'https://coded-astro-boost.preview.emergentagent.com';
  
  try {
    const response = await fetch(`${apiUrl}/api/blog/`);
    if (!response.ok) {
      return [];
    }
    
    const data = await response.json();
    const posts = data.posts || data || [];
    
    if (!Array.isArray(posts)) {
      return [];
    }
    
    return posts.map((post: any) => ({
      params: { slug: post.slug },
      props: { post },
    }));
  } catch (error) {
    console.warn('Failed to fetch blog posts for static paths:', error);
    return [];
  }
}

const { post } = Astro.props;

// Format date
const formatDate = (dateString: string) => {
  return new Date(dateString).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
};
---

<BaseLayout
  title={`${post.title} - Buuk Blog`}
  description={post.excerpt || post.content.substring(0, 160).replace(/<[^>]*>/g, '')}
  currentPage="blog"
>
  <main>
    <!-- Article Header -->
    <section style="padding: 6rem 1rem 3rem; background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);">
      <div style="max-width: 800px; margin: 0 auto;">
        <a href="/blog" style="display: inline-flex; align-items: center; gap: 0.5rem; color: #14B8A6; font-weight: 500; margin-bottom: 1.5rem; text-decoration: none;">
          ← Back to Blog
        </a>
        
        <div style="display: flex; gap: 1rem; margin-bottom: 1rem; flex-wrap: wrap; align-items: center;">
          {post.category && (
            <span style="background: #14B8A6; color: white; padding: 0.25rem 0.75rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 600;">
              {post.category}
            </span>
          )}
          <span style="color: #64748b; font-size: 0.875rem;">
            {formatDate(post.created_at)}
          </span>
          {post.readTime && (
            <span style="color: #64748b; font-size: 0.875rem;">
              · {post.readTime} min read
            </span>
          )}
        </div>
        
        <h1 style="font-size: 2.5rem; font-weight: 700; color: #0f172a; line-height: 1.2; margin-bottom: 1rem;">
          {post.title}
        </h1>
        
        {post.author && (
          <div style="display: flex; align-items: center; gap: 0.75rem;">
            <div style="width: 40px; height: 40px; background: #14B8A6; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; font-weight: 600;">
              {post.author.charAt(0).toUpperCase()}
            </div>
            <span style="font-weight: 500; color: #0f172a;">{post.author}</span>
          </div>
        )}
      </div>
    </section>

    <!-- Featured Image -->
    {post.image && (
      <section style="padding: 0 1rem;">
        <div style="max-width: 800px; margin: 0 auto;">
          <img 
            src={post.image} 
            alt={post.title}
            style="width: 100%; height: 400px; object-fit: cover; border-radius: 16px; margin-top: -2rem; box-shadow: 0 20px 40px rgba(0,0,0,0.1);"
          />
        </div>
      </section>
    )}

    <!-- Article Content -->
    <section style="padding: 3rem 1rem 5rem;">
      <div style="max-width: 700px; margin: 0 auto;">
        <article class="blog-content" set:html={post.content} />
      </div>
    </section>

    <!-- CTA Section -->
    <section style="padding: 4rem 1rem; background: #14B8A6; color: white; text-align: center;">
      <div style="max-width: 600px; margin: 0 auto;">
        <h2 style="font-size: 2rem; font-weight: 700; margin-bottom: 1rem;">
          Ready to streamline your bookings?
        </h2>
        <p style="font-size: 1.125rem; opacity: 0.95; margin-bottom: 2rem;">
          Join thousands of businesses using Buuk to manage appointments.
        </p>
        <a href="https://app.onbuuk.com" style="display: inline-block; padding: 1rem 2rem; background: white; color: #14B8A6; font-weight: 600; border-radius: 8px; text-decoration: none;">
          Start Free Trial →
        </a>
      </div>
    </section>
  </main>

  <style>
    .blog-content {
      font-size: 1.125rem;
      line-height: 1.8;
      color: #334155;
    }

    .blog-content h1,
    .blog-content h2,
    .blog-content h3,
    .blog-content h4 {
      color: #0f172a;
      margin-top: 2rem;
      margin-bottom: 1rem;
      font-weight: 700;
    }

    .blog-content h2 {
      font-size: 1.75rem;
    }

    .blog-content h3 {
      font-size: 1.5rem;
    }

    .blog-content p {
      margin-bottom: 1.5rem;
    }

    .blog-content a {
      color: #14B8A6;
      text-decoration: underline;
    }

    .blog-content a:hover {
      color: #0d9488;
    }

    .blog-content ul,
    .blog-content ol {
      margin-bottom: 1.5rem;
      padding-left: 1.5rem;
    }

    .blog-content li {
      margin-bottom: 0.5rem;
    }

    .blog-content blockquote {
      border-left: 4px solid #14B8A6;
      padding-left: 1.5rem;
      margin: 2rem 0;
      font-style: italic;
      color: #64748b;
    }

    .blog-content img {
      max-width: 100%;
      height: auto;
      border-radius: 8px;
      margin: 2rem 0;
    }

    .blog-content pre {
      background: #1e293b;
      color: #e2e8f0;
      padding: 1.5rem;
      border-radius: 8px;
      overflow-x: auto;
      margin: 2rem 0;
    }

    .blog-content code {
      background: #f1f5f9;
      padding: 0.25rem 0.5rem;
      border-radius: 4px;
      font-size: 0.9em;
    }

    .blog-content pre code {
      background: transparent;
      padding: 0;
    }
  </style>
</BaseLayout>
