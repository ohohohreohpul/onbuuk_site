---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found - Buuk"
  description="The page you're looking for doesn't exist."
>
  <main style="padding: 8rem 1rem; text-align: center; min-height: 60vh; display: flex; align-items: center; justify-content: center;">
    <div style="max-width: 500px;">
      <div style="font-size: 8rem; font-weight: 700; color: #14B8A6; line-height: 1; margin-bottom: 1rem;">404</div>
      <h1 style="font-size: 2rem; font-weight: 700; color: #0f172a; margin-bottom: 1rem;">
        Page Not Found
      </h1>
      <p style="color: #64748b; margin-bottom: 2rem; line-height: 1.6;">
        Sorry, we couldn't find the page you're looking for. It might have been moved or deleted.
      </p>
      <a href="/" style="display: inline-block; padding: 1rem 2rem; background: #14B8A6; color: white; font-weight: 600; border-radius: 8px; text-decoration: none;">
        Back to Home
      </a>
    </div>
  </main>
</BaseLayout>
