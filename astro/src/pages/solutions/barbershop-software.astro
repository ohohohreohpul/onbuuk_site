---
import BaseLayout from '../../layouts/BaseLayout.astro';

const features = [
  { title: 'Walk-in Queue', description: 'Manage walk-ins with digital queue system. Clients can check wait times online.' },
  { title: 'Barber Scheduling', description: 'Each barber manages their own schedule, breaks, and client preferences.' },
  { title: 'Service Pricing', description: 'Set up haircuts, beard trims, hot towel shaves with clear pricing.' },
  { title: 'Client Loyalty', description: 'Reward regular customers with loyalty points and special discounts.' },
  { title: 'Team Performance', description: 'Track each barber\'s bookings, revenue, and client retention.' },
  { title: 'Mobile Booking', description: 'Clients book from their phone. Perfect for the modern barbershop.' }
];
---

<BaseLayout
  title="Barbershop Booking Software | Barber Appointment System - Buuk"
  description="Barbershop booking software with walk-in queue, barber scheduling, and loyalty programs. Perfect for modern barbershops. Start free."
  currentPage="solutions"
>
  <main class="pt-16">
    <!-- Hero Section -->
    <section class="py-20 px-6 lg:px-24 bg-gradient-to-br from-gray-900 to-gray-800 relative overflow-hidden">
      <div class="absolute inset-0 bg-grid-pattern opacity-10"></div>
      
      <div class="max-w-7xl mx-auto relative z-10">
        <div class="grid lg:grid-cols-2 gap-12 items-center">
          <div class="animate-on-scroll">
            <div class="inline-flex items-center space-x-2 bg-white/10 px-4 py-2 rounded-full mb-6">
              <span class="text-sm font-semibold text-white">💈 For Barbershops</span>
            </div>
            <h1 class="text-4xl lg:text-5xl font-bold text-white mb-6">
              Barbershop Software for <span class="text-secondary">Modern Barbers</span>
            </h1>
            <p class="text-xl text-gray-300 mb-8 leading-relaxed">
              Manage your barbershop with style. Walk-in queues, online booking, and loyalty programs built for barbers.
            </p>
            <a href="https://app.onbuuk.com" class="inline-flex items-center bg-primary hover:bg-primary-dark text-white px-8 py-4 rounded-xl font-semibold transition-all duration-300 shadow-lg hover:shadow-xl hover:-translate-y-1 btn-shine">
              Start Free Trial
              <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
          </div>
          <div class="animate-on-scroll-right">
            <img 
              src="https://images.unsplash.com/photo-1675034743339-0b0747047727?w=800&q=80" 
              alt="Barbershop haircut service"
              class="rounded-2xl shadow-2xl w-full h-[400px] object-cover"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Features Grid -->
    <section class="py-20 px-6 lg:px-24">
      <div class="max-w-7xl mx-auto">
        <div class="text-center mb-16 animate-on-scroll">
          <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 mb-6">
            Features Barbers Love
          </h2>
          <p class="text-xl text-gray-600 max-w-2xl mx-auto">
            Everything you need to run a successful barbershop
          </p>
        </div>
        
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {features.map((feature, idx) => (
            <div class={`bg-white border-2 border-gray-200 rounded-2xl p-8 card-hover card-hover-glow animate-on-scroll stagger-${(idx % 6) + 1}`}>
              <h3 class="text-xl font-bold text-gray-900 mb-4">{feature.title}</h3>
              <p class="text-gray-600">{feature.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-20 px-6 lg:px-24 bg-gray-900 text-white text-center">
      <div class="max-w-3xl mx-auto animate-on-scroll">
        <h2 class="text-3xl lg:text-4xl font-bold mb-6">Ready to Level Up Your Barbershop?</h2>
        <p class="text-lg text-gray-300 mb-8">Join barbershops already crushing it with Buuk.</p>
        <a href="https://app.onbuuk.com" class="inline-block bg-primary hover:bg-primary-dark text-white font-semibold px-8 py-4 rounded-xl hover:shadow-lg transition-all">
          Get Started Free →
        </a>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) entry.target.classList.add('visible');
    });
  }, { threshold: 0.1 });
  document.querySelectorAll('.animate-on-scroll, .animate-on-scroll-right').forEach(el => observer.observe(el));
</script>
