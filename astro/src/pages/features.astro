---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Features - Buuk Appointment Booking"
  description="Discover all the powerful features that make Buuk the best appointment booking platform for salons, spas, and service businesses."
  currentPage="features"
>
  <main>
    <!-- Hero Section -->
    <section style="padding: 6rem 1rem 4rem; background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);">
      <div style="max-width: 1200px; margin: 0 auto; text-align: center;">
        <h1 style="font-size: 3rem; font-weight: 700; color: #0f172a; margin-bottom: 1rem;">
          Powerful Features for Modern Businesses
        </h1>
        <p style="font-size: 1.25rem; color: #64748b; max-width: 600px; margin: 0 auto;">
          Everything you need to manage appointments and grow your business
        </p>
      </div>
    </section>

    <!-- Features Grid -->
    <section style="padding: 5rem 1rem;">
      <div style="max-width: 1200px; margin: 0 auto;">
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(350px, 1fr)); gap: 2rem;">
          
          <!-- Online Scheduling -->
          <div style="padding: 2rem; background: white; border: 2px solid #e2e8f0; border-radius: 16px;">
            <div style="width: 64px; height: 64px; background: #14B8A6; border-radius: 16px; display: flex; align-items: center; justify-content: center; margin-bottom: 1.5rem;">
              <span style="color: white; font-size: 2rem;">📅</span>
            </div>
            <h3 style="font-size: 1.5rem; font-weight: 700; color: #0f172a; margin-bottom: 1rem;">Online Scheduling</h3>
            <p style="color: #64748b; line-height: 1.7; margin-bottom: 1rem;">Let your customers book appointments 24/7 from your website, social media, or dedicated booking page.</p>
            <ul style="color: #64748b; line-height: 2; padding-left: 1.5rem;">
              <li>Real-time availability</li>
              <li>Multi-service booking</li>
              <li>Custom booking forms</li>
            </ul>
          </div>

          <!-- Automated Reminders -->
          <div style="padding: 2rem; background: white; border: 2px solid #e2e8f0; border-radius: 16px;">
            <div style="width: 64px; height: 64px; background: #A4D23E; border-radius: 16px; display: flex; align-items: center; justify-content: center; margin-bottom: 1.5rem;">
              <span style="color: #0f172a; font-size: 2rem;">🔔</span>
            </div>
            <h3 style="font-size: 1.5rem; font-weight: 700; color: #0f172a; margin-bottom: 1rem;">Automated Reminders</h3>
            <p style="color: #64748b; line-height: 1.7; margin-bottom: 1rem;">Reduce no-shows by up to 90% with automated SMS and email reminders.</p>
            <ul style="color: #64748b; line-height: 2; padding-left: 1.5rem;">
              <li>SMS notifications</li>
              <li>Email reminders</li>
              <li>Custom timing</li>
            </ul>
          </div>

          <!-- Team Management -->
          <div style="padding: 2rem; background: white; border: 2px solid #e2e8f0; border-radius: 16px;">
            <div style="width: 64px; height: 64px; background: #14B8A6; border-radius: 16px; display: flex; align-items: center; justify-content: center; margin-bottom: 1.5rem;">
              <span style="color: white; font-size: 2rem;">👥</span>
            </div>
            <h3 style="font-size: 1.5rem; font-weight: 700; color: #0f172a; margin-bottom: 1rem;">Team Management</h3>
            <p style="color: #64748b; line-height: 1.7; margin-bottom: 1rem;">Manage multiple staff members, their schedules, and services all in one place.</p>
            <ul style="color: #64748b; line-height: 2; padding-left: 1.5rem;">
              <li>Individual calendars</li>
              <li>Service assignments</li>
              <li>Break time management</li>
            </ul>
          </div>

          <!-- Payment Processing -->
          <div style="padding: 2rem; background: white; border: 2px solid #e2e8f0; border-radius: 16px;">
            <div style="width: 64px; height: 64px; background: #14B8A6; border-radius: 16px; display: flex; align-items: center; justify-content: center; margin-bottom: 1.5rem;">
              <span style="color: white; font-size: 2rem;">💳</span>
            </div>
            <h3 style="font-size: 1.5rem; font-weight: 700; color: #0f172a; margin-bottom: 1rem;">Payment Processing</h3>
            <p style="color: #64748b; line-height: 1.7; margin-bottom: 1rem;">Accept payments securely during booking with Stripe integration.</p>
            <ul style="color: #64748b; line-height: 2; padding-left: 1.5rem;">
              <li>Secure online payments</li>
              <li>Deposit collection</li>
              <li>No-show fees</li>
            </ul>
          </div>

          <!-- Calendar Sync -->
          <div style="padding: 2rem; background: white; border: 2px solid #e2e8f0; border-radius: 16px;">
            <div style="width: 64px; height: 64px; background: #A4D23E; border-radius: 16px; display: flex; align-items: center; justify-content: center; margin-bottom: 1.5rem;">
              <span style="color: #0f172a; font-size: 2rem;">🔄</span>
            </div>
            <h3 style="font-size: 1.5rem; font-weight: 700; color: #0f172a; margin-bottom: 1rem;">Calendar Sync</h3>
            <p style="color: #64748b; line-height: 1.7; margin-bottom: 1rem;">Sync with Google Calendar and Outlook to keep all your appointments in one place.</p>
            <ul style="color: #64748b; line-height: 2; padding-left: 1.5rem;">
              <li>Google Calendar sync</li>
              <li>Outlook integration</li>
              <li>Two-way sync</li>
            </ul>
          </div>

          <!-- Analytics -->
          <div style="padding: 2rem; background: white; border: 2px solid #e2e8f0; border-radius: 16px;">
            <div style="width: 64px; height: 64px; background: #14B8A6; border-radius: 16px; display: flex; align-items: center; justify-content: center; margin-bottom: 1.5rem;">
              <span style="color: white; font-size: 2rem;">📊</span>
            </div>
            <h3 style="font-size: 1.5rem; font-weight: 700; color: #0f172a; margin-bottom: 1rem;">Analytics & Reports</h3>
            <p style="color: #64748b; line-height: 1.7; margin-bottom: 1rem;">Get detailed insights into your business performance with comprehensive reports.</p>
            <ul style="color: #64748b; line-height: 2; padding-left: 1.5rem;">
              <li>Revenue tracking</li>
              <li>Customer insights</li>
              <li>Staff performance</li>
            </ul>
          </div>

        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section style="padding: 5rem 1rem; background: #14B8A6; color: white; text-align: center;">
      <div style="max-width: 800px; margin: 0 auto;">
        <h2 style="font-size: 2.5rem; font-weight: 700; margin-bottom: 1rem;">
          Ready to try these features?
        </h2>
        <p style="font-size: 1.125rem; opacity: 0.95; margin-bottom: 2rem;">
          Start your free trial today. No credit card required.
        </p>
        <a href="https://app.onbuuk.com" style="display: inline-block; padding: 1rem 2rem; background: white; color: #14B8A6; font-weight: 600; border-radius: 8px; text-decoration: none;">
          Start Free Trial →
        </a>
      </div>
    </section>
  </main>
</BaseLayout>
