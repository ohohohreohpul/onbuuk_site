---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Features - Buuk"
  description="Discover all the powerful features that make Buuk the best appointment booking platform."
>
  <header style="padding: 2rem 1rem; border-bottom: 1px solid #e2e8f0;">
    <div style="max-width: 1200px; margin: 0 auto;">
      <img src="/buuklogo.png" alt="Buuk Logo" style="height: 50px;" />
    </div>
  </header>

  <main style="padding: 4rem 1rem;">
    <div style="max-width: 1200px; margin: 0 auto;">
      <h1 style="font-size: 2.5rem; margin-bottom: 3rem; text-align: center;">
        Powerful Features for Modern Businesses
      </h1>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 2rem; margin-bottom: 3rem;">
        <div style="padding: 2rem; background: #f8fafc; border-radius: 8px;">
          <h3 style="margin-bottom: 1rem; color: #667eea; font-size: 1.25rem;">Online Scheduling</h3>
          <p style="line-height: 1.6;">Let your customers book appointments 24/7 from your website.</p>
        </div>
        <div style="padding: 2rem; background: #f8fafc; border-radius: 8px;">
          <h3 style="margin-bottom: 1rem; color: #667eea; font-size: 1.25rem;">Automated Reminders</h3>
          <p style="line-height: 1.6;">Send SMS and email reminders to reduce no-shows.</p>
        </div>
        <div style="padding: 2rem; background: #f8fafc; border-radius: 8px;">
          <h3 style="margin-bottom: 1rem; color: #667eea; font-size: 1.25rem;">Team Management</h3>
          <p style="line-height: 1.6;">Manage multiple staff members and their availability.</p>
        </div>
        <div style="padding: 2rem; background: #f8fafc; border-radius: 8px;">
          <h3 style="margin-bottom: 1rem; color: #667eea; font-size: 1.25rem;">Payment Processing</h3>
          <p style="line-height: 1.6;">Accept payments securely during booking.</p>
        </div>
        <div style="padding: 2rem; background: #f8fafc; border-radius: 8px;">
          <h3 style="margin-bottom: 1rem; color: #667eea; font-size: 1.25rem;">Calendar Sync</h3>
          <p style="line-height: 1.6;">Sync with Google Calendar and Outlook.</p>
        </div>
        <div style="padding: 2rem; background: #f8fafc; border-radius: 8px;">
          <h3 style="margin-bottom: 1rem; color: #667eea; font-size: 1.25rem;">Analytics & Reports</h3>
          <p style="line-height: 1.6;">Get insights into your business performance.</p>
        </div>
      </div>
    </div>
  </main>

  <footer style="background: #0f172a; color: white; padding: 2rem 1rem; text-align: center; margin-top: 4rem;">
    <div style="max-width: 1200px; margin: 0 auto;">
      <p>&copy; 2024 Buuk. All rights reserved.</p>
    </div>
  </footer>
</BaseLayout>
