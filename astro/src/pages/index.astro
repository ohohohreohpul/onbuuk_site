---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Buuk - Appointment Booking Solution"
  description="The easiest way to manage appointments and bookings. Schedule, manage, and scale your business with Buuk."
>
  <header style="padding: 2rem 1rem; border-bottom: 1px solid #e2e8f0;">
    <div style="max-width: 1200px; margin: 0 auto;">
      <img src="/buuklogo.png" alt="Buuk Logo" style="height: 50px;" />
    </div>
  </header>

  <main>
    <section style="padding: 4rem 1rem; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; text-align: center;">
      <div style="max-width: 1200px; margin: 0 auto;">
        <h1 style="font-size: 3.5rem; margin-bottom: 1rem; font-weight: 700;">
          Schedule Smarter
        </h1>
        <p style="font-size: 1.25rem; margin-bottom: 2rem; opacity: 0.95;">
          The easiest appointment booking platform for businesses of all sizes
        </p>
        <a href="#get-started" style="display: inline-block; padding: 1rem 2rem; background: white; color: #667eea; font-weight: 600; border-radius: 8px; cursor: pointer;">
          Get Started Free
        </a>
      </div>
    </section>

    <section style="padding: 4rem 1rem;">
      <div style="max-width: 1200px; margin: 0 auto;">
        <h2 style="font-size: 2.5rem; text-align: center; margin-bottom: 3rem;">
          Why Choose Buuk?
        </h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2rem;">
          <div style="padding: 2rem; background: #f8fafc; border-radius: 8px;">
            <h3 style="margin-bottom: 1rem; color: #667eea;">Easy Setup</h3>
            <p>Get started in minutes, not days. No technical knowledge required.</p>
          </div>
          <div style="padding: 2rem; background: #f8fafc; border-radius: 8px;">
            <h3 style="margin-bottom: 1rem; color: #667eea;">Powerful Features</h3>
            <p>Everything you need to manage appointments and grow your business.</p>
          </div>
          <div style="padding: 2rem; background: #f8fafc; border-radius: 8px;">
            <h3 style="margin-bottom: 1rem; color: #667eea;">Always Available</h3>
            <p>24/7 support and reliability you can count on.</p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer style="background: #0f172a; color: white; padding: 2rem 1rem; text-align: center; margin-top: 4rem;">
    <div style="max-width: 1200px; margin: 0 auto;">
      <p>&copy; 2024 Buuk. All rights reserved.</p>
    </div>
  </footer>
</BaseLayout>
