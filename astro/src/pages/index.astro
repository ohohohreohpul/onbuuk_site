---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Features from '../components/Features.astro';
import WhyChooseBuuk from '../components/WhyChooseBuuk.astro';
import UIShowcase from '../components/UIShowcase.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Testimonials from '../components/Testimonials.astro';
import Pricing from '../components/Pricing.astro';
import CTA from '../components/CTA.astro';
---

<BaseLayout
  title="Buuk - Appointment Booking Software for Salons & Spas"
  description="The easiest way to manage appointments and bookings. Schedule, manage, and scale your salon, spa, or wellness business with Buuk."
  currentPage="home"
>
  <main>
    <Hero />
    <Features />
    <WhyChooseBuuk />
    <UIShowcase />
    <HowItWorks />
    <Testimonials />
    <Pricing />
    <CTA />
  </main>
</BaseLayout>
