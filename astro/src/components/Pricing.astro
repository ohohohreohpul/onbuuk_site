---
const plans = [
  {
    name: 'Free',
    price: '0',
    currency: '€',
    description: 'Perfect for getting started with basic booking needs',
    features: ['1 admin user (owner only)', 'Up to 50 bookings per month', 'Up to 3 services', '1 specialist', 'Email notifications', 'Basic booking system', 'Customer management'],
    highlighted: false
  },
  {
    name: 'Standard',
    price: '29',
    currency: '€',
    description: 'Ideal for small to medium-sized businesses',
    features: ['Up to 3 admin users', 'Unlimited bookings', 'Up to 10 services', 'Up to 3 specialists', 'Gift cards enabled', 'Basic loyalty program', 'Custom logo', 'Email notifications', 'Calendar view', 'Customer portal', 'Booking form customization'],
    highlighted: true,
    badge: 'POPULAR'
  },
  {
    name: 'Pro',
    price: '45',
    currency: '€',
    description: 'Full power for growing businesses',
    features: ['Unlimited admin users', 'Unlimited bookings', 'Unlimited services', 'Unlimited specialists', 'Advanced gift cards', 'Advanced loyalty program', 'Full custom branding', 'Remove "Powered by Buuk" badge', 'Email notifications', 'Priority support', 'Custom domain support', 'Advanced permissions'],
    highlighted: false
  }
];
---

<section id="pricing" class="py-24 px-6 lg:px-24 bg-gray-50 relative overflow-hidden">
  <!-- Animated Background -->
  <div class="absolute inset-0 bg-grid-pattern opacity-30"></div>
  <div class="absolute top-0 left-1/4 w-96 h-96 bg-primary/5 rounded-full blur-3xl animate-pulse-glow"></div>
  <div class="absolute bottom-0 right-1/4 w-96 h-96 bg-secondary/5 rounded-full blur-3xl animate-pulse-glow" style="animation-delay: 2s;"></div>
  
  <div class="max-w-7xl mx-auto relative z-10">
    <!-- Section Header -->
    <div class="text-center mb-16 animate-on-scroll">
      <div class="inline-flex items-center space-x-2 bg-white border-2 border-gray-200 px-4 py-2 rounded-full mb-6 shadow-sm">
        <div class="w-2 h-2 rounded-full bg-primary animate-pulse"></div>
        <span class="text-sm font-semibold text-gray-700">Pricing</span>
      </div>
      <h2 class="text-4xl lg:text-5xl font-bold text-gray-900 mb-6">
        Simple, <span class="text-gradient-animate">Transparent</span> Pricing
      </h2>
      <p class="text-xl text-gray-600 max-w-2xl mx-auto">
        Choose the plan that fits your business. Start for free, upgrade anytime.
      </p>
    </div>

    <!-- Pricing Cards -->
    <div class="grid md:grid-cols-3 gap-6 max-w-5xl mx-auto">
      {plans.map((plan, idx) => (
        <div class={`border-2 p-8 rounded-2xl relative transition-all duration-500 animate-on-scroll stagger-${idx + 1} ${
          plan.highlighted 
            ? 'bg-gradient-to-br from-primary to-teal-500 border-primary text-white shadow-2xl scale-105 z-10' 
            : 'bg-white/90 backdrop-blur-sm border-gray-200 hover:border-primary hover:shadow-2xl hover:-translate-y-2'
        }`}>
          {plan.highlighted && plan.badge && (
            <div class="absolute -top-4 left-1/2 transform -translate-x-1/2 bg-gradient-to-r from-secondary to-green-400 text-gray-900 px-5 py-1.5 rounded-full text-sm font-bold shadow-lg animate-bounce-subtle">
              {plan.badge}
            </div>
          )}
          
          <div class="mb-6 pt-2">
            <h3 class={`text-2xl font-bold mb-2 ${plan.highlighted ? 'text-white' : 'text-gray-900'}`}>
              {plan.name}
            </h3>
            <p class={`text-sm ${plan.highlighted ? 'text-white/80' : 'text-gray-600'}`}>
              {plan.description}
            </p>
          </div>
          
          <div class="mb-8">
            <div class="flex items-baseline">
              <span class={`text-5xl font-bold ${plan.highlighted ? 'text-white' : 'text-gray-900'}`}>
                {plan.currency}{plan.price}
              </span>
              <span class={`ml-2 ${plan.highlighted ? 'text-white/80' : 'text-gray-600'}`}>/month</span>
            </div>
          </div>
          
          <a 
            href="https://app.onbuuk.com"
            class={`block w-full text-center mb-8 font-semibold py-4 px-6 rounded-xl transition-all duration-300 shadow-lg btn-shine ${
              plan.highlighted 
                ? 'bg-white text-primary hover:bg-gray-100 hover:shadow-xl' 
                : 'bg-gradient-to-r from-primary to-teal-400 text-white hover:from-primary-dark hover:to-teal-500 hover:shadow-xl hover:-translate-y-0.5'
            }`}
          >
            {plan.name === 'Free' ? 'Start for Free' : 'Get Started'}
          </a>
          
          <ul class="space-y-3">
            {plan.features.map((feature) => (
              <li class="flex items-start space-x-3">
                <div class={`flex-shrink-0 w-6 h-6 rounded-lg flex items-center justify-center ${
                  plan.highlighted ? 'bg-white/20' : 'bg-primary/10'
                }`}>
                  <svg class={`w-4 h-4 ${plan.highlighted ? 'text-white' : 'text-primary'}`} fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                  </svg>
                </div>
                <span class={`text-sm ${plan.highlighted ? 'text-white' : 'text-gray-700'}`}>
                  {feature}
                </span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- FAQ Note -->
    <div class="mt-16 text-center animate-on-scroll">
      <p class="text-gray-600 text-lg">
        Start for free · No credit card required · Upgrade anytime
      </p>
    </div>
  </div>
</section>

<script>
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
      }
    });
  }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });

  document.querySelectorAll('#pricing .animate-on-scroll').forEach(el => observer.observe(el));
</script>
