---
const apiUrl = import.meta.env.API_URL || 'https://coded-astro-boost.preview.emergentagent.com';
---

<section id="cta" class="py-24 px-6 lg:px-24 bg-gradient-to-br from-[#003E37] via-[#004D40] to-[#00695C] relative overflow-hidden">
  <!-- Animated Background Elements -->
  <div class="absolute inset-0 bg-grid-pattern opacity-10"></div>
  <div class="floating-orb w-[500px] h-[500px] bg-primary/20 -top-32 -right-32 blur-3xl"></div>
  <div class="floating-orb w-[400px] h-[400px] bg-secondary/20 -bottom-32 -left-32 blur-3xl" style="animation-delay: 3s;"></div>
  
  <!-- Decorative Shapes -->
  <div class="absolute top-20 right-20 w-32 h-32 border-2 border-white/10 rounded-full animate-float"></div>
  <div class="absolute bottom-20 left-20 w-24 h-24 bg-white/5 rounded-2xl rotate-12 animate-float-delay"></div>
  
  <!-- Background Image Overlay -->
  <div class="absolute inset-0 opacity-10">
    <img 
      src="https://images.unsplash.com/photo-1560066984-138dadb4c035?w=1920&q=60" 
      alt=""
      class="w-full h-full object-cover"
    />
  </div>
  
  <div class="max-w-7xl mx-auto relative z-10">
    <div class="grid lg:grid-cols-2 gap-16 items-center">
      <!-- Left Content -->
      <div class="text-white animate-on-scroll-left">
        <div class="inline-flex items-center space-x-2 bg-white/10 backdrop-blur-sm border border-white/20 px-4 py-2 rounded-full mb-6">
          <svg class="w-4 h-4 text-primary animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
          </svg>
          <span class="text-sm font-medium text-white">Get Started Today</span>
        </div>
        
        <h2 class="text-4xl lg:text-5xl font-bold mb-6 leading-tight">
          Ready to Transform Your <span class="text-gradient-animate">Booking Experience</span>?
        </h2>
        <p class="text-lg text-gray-300 mb-8 leading-relaxed">
          Join hundreds of salons and spas using buuk to streamline operations and delight customers.
        </p>
        
        <!-- Showcase Images -->
        <div class="flex items-center gap-4 mb-8">
          <div class="flex -space-x-3">
            <img src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=80&q=80" alt="User" class="w-10 h-10 rounded-full border-2 border-white object-cover" />
            <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=80&q=80" alt="User" class="w-10 h-10 rounded-full border-2 border-white object-cover" />
            <img src="https://images.unsplash.com/photo-1438761681033-6461ffad8d80?w=80&q=80" alt="User" class="w-10 h-10 rounded-full border-2 border-white object-cover" />
            <img src="https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?w=80&q=80" alt="User" class="w-10 h-10 rounded-full border-2 border-white object-cover" />
          </div>
          <div>
            <p class="text-white font-semibold">500+ businesses</p>
            <p class="text-gray-400 text-sm">trust Buuk daily</p>
          </div>
        </div>
        
        <!-- Big CTA Button -->
        <a
          href="https://app.onbuuk.com"
          class="group inline-flex items-center bg-gradient-to-r from-primary to-teal-400 hover:from-primary-dark hover:to-teal-500 text-white font-bold px-10 py-5 text-lg mb-8 shadow-2xl transition-all duration-300 rounded-xl hover:-translate-y-1 btn-shine"
        >
          Start for Free
          <svg class="ml-3 w-6 h-6 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
        
        <!-- Benefits List -->
        <ul class="space-y-4">
          {['Start for free, no credit card required', 'Setup in under 30 minutes', 'Upgrade anytime as you grow'].map((item, idx) => (
            <li class={`flex items-center space-x-3 animate-on-scroll stagger-${idx + 1}`}>
              <div class="w-7 h-7 rounded-lg bg-primary flex items-center justify-center flex-shrink-0 shadow-lg">
                <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                </svg>
              </div>
              <span class="text-lg">{item}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Right Content - Form -->
      <div class="bg-white/95 backdrop-blur-sm border-2 border-white/20 p-8 lg:p-10 shadow-2xl rounded-2xl animate-on-scroll-right card-hover">
        <h3 class="text-2xl font-bold text-gray-900 mb-2">
          Request a Demo
        </h3>
        <p class="text-gray-600 mb-8">Want a personalized walkthrough? We'll reach out to you.</p>
        
        <form id="demo-form" class="space-y-5">
          <div>
            <label for="name" class="block text-sm font-semibold text-gray-900 mb-2">
              Your Name *
            </label>
            <input
              id="name"
              name="name"
              type="text"
              required
              placeholder="John Doe"
              class="w-full h-14 px-4 bg-gray-50 border-2 border-gray-200 text-gray-900 placeholder:text-gray-400 focus:border-primary focus:outline-none rounded-xl transition-all duration-300 hover:border-gray-300"
            />
          </div>

          <div>
            <label for="email" class="block text-sm font-semibold text-gray-900 mb-2">
              Email Address *
            </label>
            <input
              id="email"
              name="email"
              type="email"
              required
              placeholder="john@example.com"
              class="w-full h-14 px-4 bg-gray-50 border-2 border-gray-200 text-gray-900 placeholder:text-gray-400 focus:border-primary focus:outline-none rounded-xl transition-all duration-300 hover:border-gray-300"
            />
          </div>

          <div>
            <label for="businessName" class="block text-sm font-semibold text-gray-900 mb-2">
              Business Name *
            </label>
            <input
              id="businessName"
              name="businessName"
              type="text"
              required
              placeholder="Your Salon Name"
              class="w-full h-14 px-4 bg-gray-50 border-2 border-gray-200 text-gray-900 placeholder:text-gray-400 focus:border-primary focus:outline-none rounded-xl transition-all duration-300 hover:border-gray-300"
            />
          </div>

          <div>
            <label for="message" class="block text-sm font-semibold text-gray-900 mb-2">
              Tell us about your needs (Optional)
            </label>
            <textarea
              id="message"
              name="message"
              placeholder="What are you looking for in a booking system?"
              rows="4"
              class="w-full px-4 py-3 bg-gray-50 border-2 border-gray-200 text-gray-900 placeholder:text-gray-400 focus:border-primary focus:outline-none rounded-xl resize-none transition-all duration-300 hover:border-gray-300"
            ></textarea>
          </div>

          <button 
            type="submit"
            class="w-full bg-gradient-to-r from-primary to-teal-400 hover:from-primary-dark hover:to-teal-500 text-white h-14 text-base font-bold shadow-lg transition-all duration-300 rounded-xl hover:shadow-xl hover:-translate-y-0.5 btn-shine"
          >
            Request Demo
          </button>
          
          <div id="form-status" class="hidden p-4 rounded-xl text-center text-sm font-medium"></div>
        </form>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ apiUrl }}>
  // Initialize scroll animations
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
      }
    });
  }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });

  document.querySelectorAll('#cta .animate-on-scroll, #cta .animate-on-scroll-left, #cta .animate-on-scroll-right').forEach(el => {
    observer.observe(el);
  });

  // Form handling
  const form = document.getElementById('demo-form');
  const statusDiv = document.getElementById('form-status');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const formData = new FormData(form);
    const data = {
      name: formData.get('name'),
      email: formData.get('email'),
      businessName: formData.get('businessName'),
      message: formData.get('message'),
    };

    const submitBtn = form.querySelector('button[type="submit"]');
    const originalText = submitBtn.textContent;
    submitBtn.textContent = 'Sending...';
    submitBtn.disabled = true;

    try {
      const response = await fetch(`${apiUrl}/api/contact`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });
      
      const result = await response.json();
      
      statusDiv.classList.remove('hidden');
      if (response.ok && result.success) {
        statusDiv.className = 'p-4 rounded-xl text-center text-sm font-medium bg-green-50 text-green-800 border-2 border-green-200';
        statusDiv.textContent = '✓ Thank you! We\'ll contact you shortly.';
        form.reset();
      } else {
        statusDiv.className = 'p-4 rounded-xl text-center text-sm font-medium bg-red-50 text-red-800 border-2 border-red-200';
        statusDiv.textContent = result.detail || 'Something went wrong. Please try again.';
      }
    } catch (error) {
      statusDiv.classList.remove('hidden');
      statusDiv.className = 'p-4 rounded-xl text-center text-sm font-medium bg-red-50 text-red-800 border-2 border-red-200';
      statusDiv.textContent = 'Failed to submit. Please try again later.';
    } finally {
      submitBtn.textContent = originalText;
      submitBtn.disabled = false;
    }
  });
</script>
