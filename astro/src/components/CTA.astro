---
const apiUrl = import.meta.env.API_URL || 'https://coded-astro-boost.preview.emergentagent.com';
---

<section id="cta" class="py-24 px-6 lg:px-24 bg-dark-green">
  <div class="max-w-7xl mx-auto">
    <div class="grid lg:grid-cols-2 gap-16 items-center">
      <!-- Left Content -->
      <div class="text-white">
        <div class="inline-flex items-center space-x-2 bg-white/10 border border-white/20 px-3 py-1.5 rounded-full mb-6">
          <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
          </svg>
          <span class="text-sm text-white">Get Started Today</span>
        </div>
        
        <h2 class="text-4xl lg:text-5xl font-bold mb-6 leading-tight">
          Ready to Transform Your Booking Experience?
        </h2>
        <p class="text-lg text-gray-300 mb-8 leading-relaxed">
          Join hundreds of salons and spas using buuk to streamline operations and delight customers.
        </p>
        
        <!-- Big CTA Button -->
        <a
          href="https://app.onbuuk.com"
          class="inline-flex items-center bg-primary hover:bg-primary-dark text-white font-bold px-10 py-4 text-lg mb-8 shadow-lg transition-all rounded-lg"
        >
          Start for Free
          <svg class="ml-2 w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
        
        <!-- Benefits List -->
        <ul class="space-y-4 mb-8">
          {['Start for free, no credit card required', 'Setup in under 30 minutes', 'Upgrade anytime as you grow'].map((item) => (
            <li class="flex items-center space-x-3">
              <div class="w-6 h-6 rounded bg-primary flex items-center justify-center flex-shrink-0">
                <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                </svg>
              </div>
              <span class="text-lg">{item}</span>
            </li>
          ))}
        </ul>
        
        <p class="text-sm text-gray-400">Or fill out the form to request a personalized demo →</p>
      </div>

      <!-- Right Content - Form -->
      <div class="bg-white border-2 border-gray-200 p-8 lg:p-10 shadow-xl rounded-xl">
        <h3 class="text-2xl font-bold text-gray-900 mb-2">
          Request a Demo
        </h3>
        <p class="text-gray-600 mb-8">Want a personalized walkthrough? We'll reach out to you.</p>
        
        <form id="demo-form" class="space-y-5">
          <div>
            <label for="name" class="block text-sm font-semibold text-gray-900 mb-2">
              Your Name *
            </label>
            <input
              id="name"
              name="name"
              type="text"
              required
              placeholder="John Doe"
              class="w-full h-12 px-4 bg-white border-2 border-gray-200 text-gray-900 placeholder:text-gray-400 focus:border-primary focus:outline-none rounded-lg transition-colors"
            />
          </div>

          <div>
            <label for="email" class="block text-sm font-semibold text-gray-900 mb-2">
              Email Address *
            </label>
            <input
              id="email"
              name="email"
              type="email"
              required
              placeholder="john@example.com"
              class="w-full h-12 px-4 bg-white border-2 border-gray-200 text-gray-900 placeholder:text-gray-400 focus:border-primary focus:outline-none rounded-lg transition-colors"
            />
          </div>

          <div>
            <label for="businessName" class="block text-sm font-semibold text-gray-900 mb-2">
              Business Name *
            </label>
            <input
              id="businessName"
              name="businessName"
              type="text"
              required
              placeholder="Your Salon Name"
              class="w-full h-12 px-4 bg-white border-2 border-gray-200 text-gray-900 placeholder:text-gray-400 focus:border-primary focus:outline-none rounded-lg transition-colors"
            />
          </div>

          <div>
            <label for="message" class="block text-sm font-semibold text-gray-900 mb-2">
              Tell us about your needs (Optional)
            </label>
            <textarea
              id="message"
              name="message"
              placeholder="What are you looking for in a booking system?"
              rows="4"
              class="w-full px-4 py-3 bg-white border-2 border-gray-200 text-gray-900 placeholder:text-gray-400 focus:border-primary focus:outline-none rounded-lg resize-none transition-colors"
            ></textarea>
          </div>

          <button 
            type="submit"
            class="w-full bg-primary hover:bg-primary-dark text-white h-14 text-base font-semibold shadow-lg transition-all rounded-lg"
          >
            Request Demo
          </button>
          
          <div id="form-status" class="hidden p-3 rounded-lg text-center text-sm"></div>
        </form>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ apiUrl }}>
  const form = document.getElementById('demo-form');
  const statusDiv = document.getElementById('form-status');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const formData = new FormData(form);
    const data = {
      name: formData.get('name'),
      email: formData.get('email'),
      businessName: formData.get('businessName'),
      message: formData.get('message'),
    };

    const submitBtn = form.querySelector('button[type="submit"]');
    const originalText = submitBtn.textContent;
    submitBtn.textContent = 'Sending...';
    submitBtn.disabled = true;

    try {
      const response = await fetch(`${apiUrl}/api/contact`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });
      
      const result = await response.json();
      
      statusDiv.classList.remove('hidden');
      if (response.ok && result.success) {
        statusDiv.className = 'p-3 rounded-lg text-center text-sm bg-green-50 text-green-800 border border-green-200';
        statusDiv.textContent = 'Thank you! We\'ll contact you shortly.';
        form.reset();
      } else {
        statusDiv.className = 'p-3 rounded-lg text-center text-sm bg-red-50 text-red-800 border border-red-200';
        statusDiv.textContent = result.detail || 'Something went wrong. Please try again.';
      }
    } catch (error) {
      statusDiv.classList.remove('hidden');
      statusDiv.className = 'p-3 rounded-lg text-center text-sm bg-red-50 text-red-800 border border-red-200';
      statusDiv.textContent = 'Failed to submit. Please try again later.';
    } finally {
      submitBtn.textContent = originalText;
      submitBtn.disabled = false;
    }
  });
</script>
