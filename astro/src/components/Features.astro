---
// Features section with bento grid and animations
---

<section id="features" class="py-24 px-6 lg:px-24 bg-white relative overflow-hidden">
  <!-- Background Pattern -->
  <div class="absolute inset-0 bg-dots-pattern opacity-50"></div>
  
  <div class="max-w-7xl mx-auto relative z-10">
    <!-- Section Header -->
    <div class="text-center mb-16 animate-on-scroll">
      <div class="inline-flex items-center space-x-2 bg-primary/10 px-4 py-2 rounded-full mb-6">
        <svg class="w-4 h-4 text-primary animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
        <span class="text-sm font-semibold text-primary">Features</span>
      </div>
      <h2 class="text-4xl lg:text-5xl font-bold text-gray-900 mb-6">
        Everything you need
      </h2>
      <p class="text-xl text-gray-600 max-w-2xl mx-auto">
        All the tools to streamline appointments and grow your business
      </p>
    </div>

    <!-- Bento Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <!-- Large Feature Card -->
      <div class="lg:col-span-2 bg-white border-2 border-gray-200 p-8 md:p-10 rounded-2xl relative overflow-hidden card-hover card-hover-glow animate-on-scroll">
        <!-- Animated background -->
        <div class="absolute top-0 right-0 w-64 h-64 bg-primary/5 rounded-full -translate-y-1/2 translate-x-1/2 animate-pulse-glow"></div>
        
        <div class="relative z-10">
          <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-primary to-teal-400 flex items-center justify-center mb-6 shadow-lg animate-float">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
          <h3 class="text-2xl md:text-3xl font-bold text-gray-900 mb-4">
            Smart Booking System
          </h3>
          <p class="text-gray-600 mb-6 text-base lg:text-lg max-w-xl">
            Real-time availability, multi-step booking flow, automated confirmations, and customer self-service portal. Make booking effortless for your clients.
          </p>
          
          <!-- Mini Calendar Demo -->
          <div class="bg-gray-50 border border-gray-200 p-5 rounded-xl">
            <div class="flex items-center justify-between mb-4">
              <div class="text-xs font-bold text-gray-900 tracking-wider">DECEMBER 2024</div>
              <div class="flex items-center space-x-2">
                <div class="w-2 h-2 bg-primary rounded-full animate-pulse"></div>
                <span class="text-xs font-medium text-gray-600">12 bookings</span>
              </div>
            </div>
            <div class="grid grid-cols-7 gap-1">
              {['S', 'M', 'T', 'W', 'T', 'F', 'S'].map((day) => (
                <div class="text-center text-xs font-semibold text-gray-500 mb-2">{day}</div>
              ))}
              {Array.from({ length: 35 }, (_, i) => {
                const hasBooking = [8, 9, 10, 14, 15, 16, 17, 21, 22, 23, 28, 29].includes(i);
                const isToday = i === 10;
                return (
                  <div class={`aspect-square flex items-center justify-center text-xs rounded-lg transition-all duration-200 hover:scale-110 cursor-pointer ${
                    isToday ? 'bg-primary text-white font-bold shadow-md' :
                    i < 8 ? 'text-gray-400' :
                    hasBooking ? 'text-gray-900 font-medium bg-primary/10' : 'text-gray-600 hover:bg-gray-100'
                  }`}>
                    {i + 1}
                  </div>
                );
              })}
            </div>
          </div>
        </div>
      </div>

      <!-- Gift Cards -->
      <div class="bg-white border-2 border-gray-200 p-8 rounded-2xl card-hover animate-on-scroll stagger-1">
        <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-secondary to-green-400 flex items-center justify-center mb-6 shadow-lg animate-float-delay">
          <svg class="w-8 h-8 text-gray-900" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 110-4h14a2 2 0 110 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7" />
          </svg>
        </div>
        <h3 class="text-2xl font-bold text-gray-900 mb-4">Gift Cards & Loyalty</h3>
        <p class="text-gray-600 mb-6">Built-in gift card system and customizable loyalty programs to boost retention.</p>
        
        <!-- Gift Card Preview -->
        <div class="bg-gradient-to-br from-secondary to-green-400 p-5 rounded-xl text-gray-900 shadow-xl transform hover:scale-105 transition-transform duration-300">
          <div class="flex justify-between items-start mb-6">
            <div class="text-sm font-bold">BUUK</div>
            <div class="text-xs font-semibold bg-white/30 px-2 py-1 rounded">GIFT</div>
          </div>
          <div class="mb-4">
            <div class="text-3xl font-bold mb-1">€50.00</div>
            <div class="text-xs opacity-80">Gift Card Value</div>
          </div>
          <div class="flex justify-between items-end">
            <div class="text-xs">
              <div class="opacity-70 text-[10px] mb-1">CODE</div>
              <div class="font-mono font-bold">GIFT-2024</div>
            </div>
            <div class="text-xs opacity-80">Exp: 12/2025</div>
          </div>
        </div>
      </div>

      <!-- Customer Portal -->
      <div class="bg-white border-2 border-gray-200 p-8 rounded-2xl card-hover animate-on-scroll stagger-2">
        <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-primary to-teal-400 flex items-center justify-center mb-6 shadow-lg">
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
        </div>
        <h3 class="text-2xl font-bold text-gray-900 mb-4">Customer Portal</h3>
        <p class="text-gray-600 mb-6">Self-service booking, history tracking, and loyalty points.</p>
        
        <div class="space-y-3">
          {[
            { name: 'Emma Wilson', points: '245', color: 'from-blue-500 to-blue-600' },
            { name: 'James Miller', points: '892', color: 'from-primary to-teal-400', active: true },
            { name: 'Sarah Davis', points: '156', color: 'from-purple-500 to-purple-600' },
          ].map((customer, idx) => (
            <div class={`flex items-center justify-between p-3 rounded-xl transition-all duration-300 cursor-pointer hover:-translate-y-0.5 ${customer.active ? 'bg-primary/10 border-2 border-primary shadow-md' : 'bg-gray-50 border border-gray-200 hover:border-primary hover:shadow-md'}`}>
              <div class="flex items-center space-x-3">
                <div class={`w-10 h-10 rounded-xl bg-gradient-to-br ${customer.color} flex items-center justify-center text-white text-xs font-bold shadow-md`}>
                  {customer.name.split(' ').map(n => n[0]).join('')}
                </div>
                <div class="text-sm font-semibold text-gray-900">{customer.name}</div>
              </div>
              <div class={`text-sm font-bold ${customer.active ? 'text-primary' : 'text-gray-700'}`}>{customer.points} pts</div>
            </div>
          ))}
        </div>
      </div>

      <!-- Payments -->
      <div class="bg-white border-2 border-gray-200 p-8 rounded-2xl card-hover animate-on-scroll stagger-3">
        <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-primary to-teal-400 flex items-center justify-center mb-6 shadow-lg">
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
          </svg>
        </div>
        <h3 class="text-2xl font-bold text-gray-900 mb-4">Stripe Payments</h3>
        <p class="text-gray-600 mb-6">Seamless online payments, in-person checkout, and gift card redemption.</p>
        
        <div class="p-5 bg-gray-50 border border-gray-200 rounded-xl">
          <div class="flex items-center justify-between mb-4">
            <div class="text-sm font-semibold text-gray-600">Total Amount</div>
            <div class="text-3xl font-bold text-gray-900">€85.00</div>
          </div>
          <div class="flex gap-2">
            {['Card', 'Stripe', 'Cash'].map((method, idx) => (
              <div class={`flex-1 p-3 rounded-xl text-center cursor-pointer transition-all duration-300 hover:scale-105 ${
                method === 'Stripe' 
                  ? 'bg-primary/10 border-2 border-primary shadow-md' 
                  : 'bg-white border border-gray-200 hover:border-primary hover:shadow-md'
              }`}>
                <div class={`text-xs font-semibold ${method === 'Stripe' ? 'text-primary' : 'text-gray-600'}`}>{method}</div>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Customization -->
      <div class="bg-white border-2 border-gray-200 p-8 rounded-2xl card-hover animate-on-scroll stagger-4">
        <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-secondary to-green-400 flex items-center justify-center mb-6 shadow-lg animate-float">
          <svg class="w-8 h-8 text-gray-900" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
          </svg>
        </div>
        <h3 class="text-2xl font-bold text-gray-900 mb-4">Brand Your Way</h3>
        <p class="text-gray-600 mb-6">Custom colors, logos, and form fields. Make it uniquely yours.</p>
        
        <div>
          <div class="text-xs font-bold text-gray-600 mb-3 tracking-wider">BRAND COLORS</div>
          <div class="grid grid-cols-3 gap-2 mb-4">
            {[
              { color: 'from-primary to-teal-400', label: '#14B8A6', light: false },
              { color: 'from-secondary to-green-400', label: '#A4D23E', light: true },
              { color: 'from-gray-800 to-gray-900', label: '#1A1A1A', light: false },
            ].map((item) => (
              <div class={`h-16 rounded-xl bg-gradient-to-br ${item.color} flex items-center justify-center shadow-lg transform hover:scale-105 transition-transform duration-300 cursor-pointer`}>
                <span class={`text-[10px] font-mono font-bold ${item.light ? 'text-gray-900' : 'text-white'}`}>{item.label}</span>
              </div>
            ))}
          </div>
          <div class="p-4 bg-gray-50 border border-gray-200 rounded-xl">
            <div class="text-[10px] font-bold text-gray-600 mb-2 tracking-wider">LOGO</div>
            <div class="h-12 bg-white border border-gray-200 rounded-lg flex items-center justify-center shadow-sm">
              <span class="text-primary font-bold text-xl">buuk</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Scroll Animation Observer for Features
  const observerOptions = {
    threshold: 0.1,
    rootMargin: '0px 0px -50px 0px'
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
      }
    });
  }, observerOptions);

  document.querySelectorAll('#features .animate-on-scroll').forEach(el => {
    observer.observe(el);
  });
</script>
