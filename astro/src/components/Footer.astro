---
const currentYear = new Date().getFullYear();
---

<footer style="background: #0f172a; color: white; padding: 4rem 1rem 2rem;">
  <div style="max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 2rem; margin-bottom: 2rem;">
    <div>
      <h4 style="margin-bottom: 1rem;">Buuk</h4>
      <p style="color: #cbd5e1; margin-bottom: 1rem;">The easiest appointment booking platform for your business.</p>
      <ul style="list-style: none; padding: 0;">
        <li style="margin-bottom: 0.5rem;">
          <a href="/" style="color: #cbd5e1; text-decoration: none; transition: color 0.2s;">Home</a>
        </li>
        <li style="margin-bottom: 0.5rem;">
          <a href="/features" style="color: #cbd5e1; text-decoration: none; transition: color 0.2s;">Features</a>
        </li>
        <li>
          <a href="/pricing" style="color: #cbd5e1; text-decoration: none; transition: color 0.2s;">Pricing</a>
        </li>
      </ul>
    </div>

    <div>
      <h4 style="margin-bottom: 1rem;">Resources</h4>
      <ul style="list-style: none; padding: 0;">
        <li style="margin-bottom: 0.5rem;">
          <a href="/blog" style="color: #cbd5e1; text-decoration: none; transition: color 0.2s;">Blog</a>
        </li>
        <li style="margin-bottom: 0.5rem;">
          <a href="/contact" style="color: #cbd5e1; text-decoration: none; transition: color 0.2s;">Contact</a>
        </li>
        <li>
          <a href="#support" style="color: #cbd5e1; text-decoration: none; transition: color 0.2s;">Support</a>
        </li>
      </ul>
    </div>

    <div>
      <h4 style="margin-bottom: 1rem;">Company</h4>
      <ul style="list-style: none; padding: 0;">
        <li style="margin-bottom: 0.5rem;">
          <a href="#about" style="color: #cbd5e1; text-decoration: none; transition: color 0.2s;">About Us</a>
        </li>
        <li style="margin-bottom: 0.5rem;">
          <a href="#privacy" style="color: #cbd5e1; text-decoration: none; transition: color 0.2s;">Privacy Policy</a>
        </li>
        <li>
          <a href="#terms" style="color: #cbd5e1; text-decoration: none; transition: color 0.2s;">Terms of Service</a>
        </li>
      </ul>
    </div>

    <div>
      <h4 style="margin-bottom: 1rem;">Connect</h4>
      <ul style="list-style: none; padding: 0;">
        <li style="margin-bottom: 0.5rem;">
          <a href="#twitter" style="color: #cbd5e1; text-decoration: none; transition: color 0.2s;">Twitter</a>
        </li>
        <li style="margin-bottom: 0.5rem;">
          <a href="#linkedin" style="color: #cbd5e1; text-decoration: none; transition: color 0.2s;">LinkedIn</a>
        </li>
        <li>
          <a href="#facebook" style="color: #cbd5e1; text-decoration: none; transition: color 0.2s;">Facebook</a>
        </li>
      </ul>
    </div>
  </div>

  <div style="border-top: 1px solid #334155; padding-top: 2rem; text-align: center; color: #cbd5e1;">
    <p>&copy; {currentYear} Buuk. All rights reserved.</p>
  </div>
</footer>
