---
const steps = [
  {
    number: '1',
    title: 'Create your account',
    description: 'Sign up in 2 minutes. Add your business details and team members.',
    icon: 'user-plus'
  },
  {
    number: '2',
    title: 'Customize your booking page',
    description: 'Match your brand with custom colors, logo, and service menu.',
    icon: 'palette'
  },
  {
    number: '3',
    title: 'Start accepting bookings',
    description: 'Share your link. Customers book 24/7 with instant confirmations.',
    icon: 'zap'
  },
  {
    number: '4',
    title: 'Grow your business',
    description: 'Track analytics, automate reminders, and increase revenue.',
    icon: 'trending-up'
  }
];
---

<section id="how-it-works" class="py-24 px-6 lg:px-24 bg-gray-50">
  <div class="max-w-7xl mx-auto">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <div class="inline-flex items-center space-x-2 bg-white border border-gray-200 px-3 py-1.5 rounded-full mb-6">
        <div class="w-2 h-2 rounded-full bg-primary"></div>
        <span class="text-sm text-gray-700">How it works</span>
      </div>
      <h2 class="text-4xl lg:text-5xl font-bold text-gray-900 mb-6">
        Get started in minutes
      </h2>
      <p class="text-xl text-gray-600 max-w-2xl mx-auto">
        Simple setup, powerful results. Start accepting bookings today.
      </p>
    </div>

    <!-- Steps Grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
      {steps.map((step, index) => (
        <div class="relative">
          <!-- Connector Line -->
          {index < steps.length - 1 && (
            <div class="hidden lg:block absolute top-12 left-full w-full h-0.5 bg-gray-200 -ml-4"></div>
          )}
          
          <div class="relative bg-white border-2 border-gray-200 rounded-xl p-6 hover:shadow-lg transition-all hover:border-primary">
            <!-- Number Badge -->
            <div class="absolute -top-3 -left-3 w-8 h-8 rounded-lg bg-primary text-white flex items-center justify-center font-bold text-sm shadow-md">
              {step.number}
            </div>
            
            <!-- Icon -->
            <div class="w-12 h-12 rounded-lg bg-gray-100 flex items-center justify-center mb-4">
              {step.icon === 'user-plus' && (
                <svg class="w-6 h-6 text-gray-900" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
                </svg>
              )}
              {step.icon === 'palette' && (
                <svg class="w-6 h-6 text-gray-900" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
                </svg>
              )}
              {step.icon === 'zap' && (
                <svg class="w-6 h-6 text-gray-900" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
              )}
              {step.icon === 'trending-up' && (
                <svg class="w-6 h-6 text-gray-900" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
                </svg>
              )}
            </div>
            
            <!-- Content -->
            <h3 class="text-lg font-bold text-gray-900 mb-2">{step.title}</h3>
            <p class="text-sm text-gray-600 leading-relaxed">{step.description}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- CTA -->
    <div class="mt-12 text-center">
      <a 
        href="https://app.onbuuk.com"
        class="inline-flex items-center space-x-2 text-primary font-semibold hover:text-primary-dark transition-colors"
      >
        <span>Start for free</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </div>
</section>
