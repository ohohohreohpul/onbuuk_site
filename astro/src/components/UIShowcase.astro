---
const appointments = [
  { name: 'Emma Wilson', service: 'Haircut & Styling', time: '9:00 AM', status: 'Confirmed', color: 'bg-blue-500' },
  { name: 'James Miller', service: 'Hair Coloring', time: '10:30 AM', status: 'Confirmed', color: 'bg-purple-500' },
  { name: 'Sarah Davis', service: 'Manicure', time: '12:00 PM', status: 'Pending', color: 'bg-pink-500' }
];
---

<section class="py-24 px-6 lg:px-24 bg-gray-50">
  <div class="max-w-7xl mx-auto">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <h2 class="text-4xl lg:text-5xl font-bold text-gray-900 mb-6">
        Powerful Dashboard at Your Fingertips
      </h2>
      <p class="text-xl text-gray-600 max-w-2xl mx-auto">
        Manage bookings, customers, payments, and analytics from one beautiful interface
      </p>
    </div>

    <!-- Stats Grid -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mb-12">
      <div class="bg-white border-2 border-gray-200 p-6 hover:border-primary hover:shadow-lg transition-all rounded-xl">
        <div class="flex items-center justify-between mb-4">
          <div class="text-xs text-gray-600 font-semibold tracking-wider">TODAY'S BOOKINGS</div>
          <div class="w-10 h-10 rounded-lg bg-blue-100 flex items-center justify-center">
            <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
        </div>
        <div class="text-4xl font-bold text-gray-900 mb-2">12</div>
        <div class="text-sm text-green-600 font-medium">+3 from yesterday</div>
      </div>

      <div class="bg-white border-2 border-gray-200 p-6 hover:border-primary hover:shadow-lg transition-all rounded-xl">
        <div class="flex items-center justify-between mb-4">
          <div class="text-xs text-gray-600 font-semibold tracking-wider">REVENUE</div>
          <div class="w-10 h-10 rounded-lg bg-green-100 flex items-center justify-center">
            <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
        </div>
        <div class="text-4xl font-bold text-gray-900 mb-2">€1.2K</div>
        <div class="text-sm text-green-600 font-medium">+18% this week</div>
      </div>

      <div class="bg-white border-2 border-gray-200 p-6 hover:border-primary hover:shadow-lg transition-all rounded-xl">
        <div class="flex items-center justify-between mb-4">
          <div class="text-xs text-gray-600 font-semibold tracking-wider">CUSTOMERS</div>
          <div class="w-10 h-10 rounded-lg bg-purple-100 flex items-center justify-center">
            <svg class="w-5 h-5 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
            </svg>
          </div>
        </div>
        <div class="text-4xl font-bold text-gray-900 mb-2">248</div>
        <div class="text-sm text-gray-600 font-medium">12 new this month</div>
      </div>

      <div class="bg-white border-2 border-gray-200 p-6 hover:border-primary hover:shadow-lg transition-all rounded-xl">
        <div class="flex items-center justify-between mb-4">
          <div class="text-xs text-gray-600 font-semibold tracking-wider">NO-SHOWS</div>
          <div class="w-10 h-10 rounded-lg bg-red-100 flex items-center justify-center">
            <svg class="w-5 h-5 text-red-600" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
            </svg>
          </div>
        </div>
        <div class="text-4xl font-bold text-gray-900 mb-2">3</div>
        <div class="text-sm text-green-600 font-medium">-60% vs last month</div>
      </div>
    </div>

    <!-- Main Dashboard Preview -->
    <div class="bg-white border-2 border-gray-200 p-8 rounded-xl shadow-lg">
      <!-- Browser Chrome -->
      <div class="flex items-center space-x-2 mb-6 pb-4 border-b border-gray-200">
        <div class="w-3 h-3 rounded-full bg-red-500"></div>
        <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
        <div class="w-3 h-3 rounded-full bg-green-500"></div>
        <div class="flex-1 ml-4">
          <div class="h-6 bg-gray-100 border border-gray-200 rounded flex items-center px-3 max-w-xs">
            <svg class="w-3 h-3 text-gray-400 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
            <span class="text-xs text-gray-600">app.buuk.io/dashboard</span>
          </div>
        </div>
      </div>

      <!-- Dashboard Header -->
      <div class="flex items-center justify-between mb-8 flex-wrap gap-4">
        <div>
          <h3 class="text-2xl font-bold text-gray-900">Dashboard Overview</h3>
          <p class="text-sm text-gray-600 mt-1">Monday, December 2, 2024 • 9:47 AM</p>
        </div>
        <button class="bg-primary hover:bg-primary-dark text-white font-semibold px-6 py-3 rounded-lg shadow-md transition-all">
          + New Booking
        </button>
      </div>

      <!-- Upcoming Appointments -->
      <div class="bg-gray-50 border border-gray-200 p-6 rounded-lg">
        <div class="flex items-center justify-between mb-6">
          <h4 class="text-lg font-bold text-gray-900">Upcoming Appointments</h4>
          <span class="text-sm text-primary font-medium cursor-pointer">View All →</span>
        </div>
        
        <div class="space-y-3">
          {appointments.map((appointment) => (
            <div class="flex items-center justify-between p-4 bg-white border border-gray-200 rounded-lg hover:border-primary transition-colors">
              <div class="flex items-center space-x-4 flex-1">
                <div class={`w-10 h-10 rounded-lg ${appointment.color} flex items-center justify-center text-white font-bold text-sm`}>
                  {appointment.name.split(' ').map(n => n[0]).join('')}
                </div>
                <div class="flex-1">
                  <p class="font-semibold text-gray-900 text-sm">{appointment.name}</p>
                  <p class="text-xs text-gray-600">{appointment.service}</p>
                </div>
                <div class="text-right mr-4">
                  <p class="text-sm font-medium text-gray-900">{appointment.time}</p>
                </div>
              </div>
              <span class={`text-xs font-medium px-3 py-1 rounded-full ${
                appointment.status === 'Confirmed' 
                  ? 'text-primary bg-primary/10 border border-primary' 
                  : 'text-yellow-600 bg-yellow-50 border border-yellow-600'
              }`}>
                {appointment.status}
              </span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
