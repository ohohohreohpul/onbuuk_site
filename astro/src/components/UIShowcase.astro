---
const appointments = [
  { name: 'Emma Wilson', service: 'Haircut & Styling', time: '9:00 AM', status: 'Confirmed', color: 'from-blue-500 to-blue-600' },
  { name: 'James Miller', service: 'Hair Coloring', time: '10:30 AM', status: 'Confirmed', color: 'from-purple-500 to-purple-600' },
  { name: 'Sarah Davis', service: 'Manicure', time: '12:00 PM', status: 'Pending', color: 'from-pink-500 to-pink-600' }
];

const stats = [
  { value: '12', label: "TODAY'S BOOKINGS", change: '+3 from yesterday', icon: 'calendar', color: 'blue' },
  { value: '€1.2K', label: 'REVENUE', change: '+18% this week', icon: 'money', color: 'green' },
  { value: '248', label: 'CUSTOMERS', change: '12 new this month', icon: 'users', color: 'purple' },
  { value: '3', label: 'NO-SHOWS', change: '-60% vs last month', icon: 'x', color: 'red' }
];
---

<section class="py-24 px-6 lg:px-24 bg-gray-50 relative overflow-hidden">
  <!-- Animated Background -->
  <div class="absolute inset-0 bg-dots-pattern"></div>
  <div class="absolute top-0 right-0 w-96 h-96 bg-primary/5 rounded-full blur-3xl animate-pulse-glow"></div>
  <div class="absolute bottom-0 left-0 w-96 h-96 bg-secondary/5 rounded-full blur-3xl animate-pulse-glow" style="animation-delay: 2s;"></div>
  
  <div class="max-w-7xl mx-auto relative z-10">
    <!-- Section Header -->
    <div class="text-center mb-16 animate-on-scroll">
      <h2 class="text-4xl lg:text-5xl font-bold text-gray-900 mb-6">
        Powerful Dashboard at Your <span class="text-gradient-animate">Fingertips</span>
      </h2>
      <p class="text-xl text-gray-600 max-w-2xl mx-auto">
        Manage bookings, customers, payments, and analytics from one beautiful interface
      </p>
    </div>

    <!-- Stats Grid -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mb-12">
      {stats.map((stat, idx) => (
        <div class={`bg-white/90 backdrop-blur-sm border-2 border-gray-200 p-6 rounded-2xl card-hover animate-on-scroll stagger-${idx + 1}`}>
          <div class="flex items-center justify-between mb-4">
            <div class="text-[10px] text-gray-600 font-bold tracking-wider">{stat.label}</div>
            <div class={`w-10 h-10 rounded-xl bg-${stat.color}-100 flex items-center justify-center`}>
              <div class={`w-2 h-2 bg-${stat.color}-500 rounded-full animate-pulse`}></div>
            </div>
          </div>
          <div class="text-4xl font-bold text-gray-900 mb-2">{stat.value}</div>
          <div class="text-sm text-green-600 font-medium">{stat.change}</div>
        </div>
      ))}
    </div>

    <!-- Main Dashboard Preview -->
    <div class="bg-white/90 backdrop-blur-sm border-2 border-gray-200 p-8 rounded-2xl shadow-2xl animate-on-scroll-scale">
      <!-- Browser Chrome -->
      <div class="flex items-center space-x-2 mb-6 pb-4 border-b border-gray-200">
        <div class="flex space-x-2">
          <div class="w-3 h-3 rounded-full bg-red-500 hover:bg-red-600 transition-colors cursor-pointer"></div>
          <div class="w-3 h-3 rounded-full bg-yellow-500 hover:bg-yellow-600 transition-colors cursor-pointer"></div>
          <div class="w-3 h-3 rounded-full bg-green-500 hover:bg-green-600 transition-colors cursor-pointer"></div>
        </div>
        <div class="flex-1 ml-4">
          <div class="h-8 bg-gray-100 border border-gray-200 rounded-lg flex items-center px-4 max-w-sm">
            <svg class="w-4 h-4 text-gray-400 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
            <span class="text-sm text-gray-600">app.onbuuk.com/dashboard</span>
          </div>
        </div>
      </div>

      <!-- Dashboard Header -->
      <div class="flex items-center justify-between mb-8 flex-wrap gap-4">
        <div>
          <h3 class="text-2xl font-bold text-gray-900">Dashboard Overview</h3>
          <p class="text-sm text-gray-600 mt-1">Monday, December 2, 2024 • 9:47 AM</p>
        </div>
        <button class="group bg-gradient-to-r from-primary to-teal-400 hover:from-primary-dark hover:to-teal-500 text-white font-semibold px-6 py-3 rounded-xl shadow-lg transition-all duration-300 hover:shadow-xl hover:-translate-y-0.5 btn-shine">
          + New Booking
        </button>
      </div>

      <!-- Upcoming Appointments -->
      <div class="bg-gray-50 border border-gray-200 p-6 rounded-xl">
        <div class="flex items-center justify-between mb-6">
          <h4 class="text-lg font-bold text-gray-900">Upcoming Appointments</h4>
          <span class="text-sm text-primary font-semibold cursor-pointer hover:text-primary-dark transition-colors hover-underline">View All →</span>
        </div>
        
        <div class="space-y-3">
          {appointments.map((appointment, idx) => (
            <div class={`flex items-center justify-between p-4 bg-white border border-gray-200 rounded-xl transition-all duration-300 hover:border-primary hover:shadow-lg hover:-translate-y-0.5 cursor-pointer animate-on-scroll stagger-${idx + 1}`}>
              <div class="flex items-center space-x-4 flex-1">
                <div class={`w-12 h-12 rounded-xl bg-gradient-to-br ${appointment.color} flex items-center justify-center text-white font-bold shadow-md`}>
                  {appointment.name.split(' ').map(n => n[0]).join('')}
                </div>
                <div class="flex-1">
                  <p class="font-semibold text-gray-900">{appointment.name}</p>
                  <p class="text-sm text-gray-600">{appointment.service}</p>
                </div>
                <div class="text-right mr-4">
                  <p class="font-bold text-gray-900">{appointment.time}</p>
                </div>
              </div>
              <span class={`text-xs font-semibold px-4 py-1.5 rounded-full ${
                appointment.status === 'Confirmed' 
                  ? 'text-primary bg-primary/10 border border-primary' 
                  : 'text-yellow-600 bg-yellow-50 border border-yellow-400'
              }`}>
                {appointment.status}
              </span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
      }
    });
  }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });

  document.querySelectorAll('section .animate-on-scroll, section .animate-on-scroll-scale').forEach(el => observer.observe(el));
</script>
